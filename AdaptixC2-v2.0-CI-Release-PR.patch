+name: Release
+
+on:
+  push:
+    tags:
+      - 'v*.*.*'
+
+permissions:
+  contents: write
+  id-token: write
+  attestations: write
+
+env:
+  GO_VERSION: '1.26.5'
+
+jobs:
+  validate-tag:
+    name: Validate release tag
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - name: Validate semantic version tag
+        shell: bash
+        env:
+          TAG: ${{ github.ref_name }}
+        run: |
+          set -euo pipefail
+          [[ "$TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]
+          [[ "${TAG#v}" == "2."* ]] || {
+            echo "This release workflow is currently scoped to AdaptixC2 v2.x" >&2
+            exit 1
+          }
+
+  server-linux:
+    name: Server package (Linux)
+    needs: validate-tag
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+
+      - name: Set up Go
+        uses: actions/setup-go@v7
+        with:
+          go-version: ${{ env.GO_VERSION }}
+          cache: true
+
+      - name: Build axtool
+        working-directory: AdaptixTools
+        run: |
+          mkdir -p dist
+          go build -buildvcs=false -ldflags='-s -w' -o dist/axtool .
+
+      - name: Build tested server distribution
+        run: ./AdaptixTools/dist/axtool adaptix.spec server build --gen-cert -d
+
+      - name: Run release smoke test
+        run: bash ./ci/integration.sh ./dist/adaptixserver ./dist/profile.yaml
+
+      - name: Create archive
+        env:
+          TAG: ${{ github.ref_name }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          mkdir -p release
+          tar -C dist -czf "release/AdaptixC2-server-${TAG}-linux-x86_64.tar.gz" .
+
+      - name: Generate SBOM
+        env:
+          SYFT_VERSION: '1.51.1'
+        shell: bash
+        run: |
+          set -euo pipefail
+          curl -fsSL "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_linux_amd64.tar.gz" -o /tmp/syft.tar.gz
+          tar -xzf /tmp/syft.tar.gz -C /tmp syft
+          /tmp/syft "dir:dist" -o spdx-json="release/AdaptixC2-server-${GITHUB_REF_NAME}.spdx.json"
+
+      - name: Generate checksums
+        working-directory: release
+        run: sha256sum * > SHA256SUMS
+
+      - name: Attest release materials
+        uses: actions/attest-build-provenance@v4
+        with:
+          subject-path: |
+            release/*.tar.gz
+            release/*.spdx.json
+            release/SHA256SUMS
+
+      - name: Upload server release materials
+        uses: actions/upload-artifact@v7
+        with:
+          name: release-server
+          path: release/
+          if-no-files-found: error
+          retention-days: 30
+
+  linux-client:
+    name: Linux client AppImage
+    needs: validate-tag
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+
+      - name: Build with the v2.0 Docker client environment
+        run: make docker-build-client
+
+      - name: Verify AppImage
+        shell: bash
+        run: |
+          set -euo pipefail
+          test -s AdaptixClient/client-dist/AdaptixClient-x86_64.AppImage
+          file AdaptixClient/client-dist/AdaptixClient-x86_64.AppImage | grep -F AppImage >/dev/null
+
+      - name: Package
+        run: |
+          mkdir -p release
+          cp AdaptixClient/client-dist/AdaptixClient-x86_64.AppImage \
+            "release/AdaptixC2-client-${GITHUB_REF_NAME}-linux-x86_64.AppImage"
+
+      - name: Generate checksum
+        working-directory: release
+        run: sha256sum * > SHA256SUMS
+
+      - name: Attest client
+        uses: actions/attest-build-provenance@v4
+        with:
+          subject-path: release/*.AppImage
+
+      - name: Upload client
+        uses: actions/upload-artifact@v7
+        with:
+          name: release-linux-client
+          path: release/
+          if-no-files-found: error
+          retention-days: 30
+
+  windows-client:
+    name: Windows client
+    needs: validate-tag
+    runs-on: windows-latest
+    timeout-minutes: 60
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+
+      - name: Provision the MinGW/Qt environment used by v2.0
+        id: msys2
+        uses: msys2/setup-msys2@v2
+        with:
+          msystem: MINGW64
+          update: true
+          install: >-
+            mingw-w64-x86_64-toolchain
+            mingw-w64-x86_64-cmake
+            mingw-w64-x86_64-ninja
+            mingw-w64-x86_64-qt6-base
+            mingw-w64-x86_64-qt6-websockets
+            mingw-w64-x86_64-qt6-declarative
+            mingw-w64-x86_64-qt6-svg
+
+      - name: Export MSYS2 MinGW prefix for CMake
+        shell: pwsh
+        env:
+          MSYS2_ROOT: ${{ steps.msys2.outputs.msys2-location }}
+        run: |
+          $mingw = Join-Path $env:MSYS2_ROOT 'mingw64'
+          $qt6 = Join-Path $mingw 'lib\cmake\Qt6'
+          $qt6Config = Join-Path $qt6 'Qt6Config.cmake'
+          if (!(Test-Path $qt6Config)) {
+            throw "Qt6 CMake package was not found at $qt6Config"
+          }
+          "MINGW_PREFIX=$mingw" | Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append
+
+      - name: Build Windows client
+        shell: cmd
+        working-directory: AdaptixClient
+        run: build.bat
+
+      - name: Verify package
+        shell: pwsh
+        run: |
+          $exe = "AdaptixClient/dist/AdaptixClient.exe"
+          if (!(Test-Path $exe)) { throw "missing $exe" }
+
+      - name: Package
+        shell: pwsh
+        run: |
+          New-Item -ItemType Directory -Force release | Out-Null
+          Compress-Archive -Path AdaptixClient/dist/* -DestinationPath "release/AdaptixC2-client-$env:GITHUB_REF_NAME-windows-x86_64.zip"
+
+      - name: Generate checksum
+        shell: pwsh
+        working-directory: release
+        run: Get-FileHash * -Algorithm SHA256 | ForEach-Object { "$($_.Hash.ToLower())  $($_.Path | Split-Path -Leaf)" } | Set-Content SHA256SUMS
+
+      - name: Upload client
+        uses: actions/upload-artifact@v7
+        with:
+          name: release-windows-client
+          path: release/
+          if-no-files-found: error
+          retention-days: 30
+
+  macos-client:
+    name: macOS client
+    needs: validate-tag
+    runs-on: macos-latest
+    timeout-minutes: 60
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+
+      - name: Install Qt/CMake
+        run: brew install qt@6 cmake ninja openssl@3
+
+      - name: Build macOS client
+        working-directory: AdaptixClient
+        shell: bash
+        run: |
+          set -euo pipefail
+          QT_PREFIX="$(brew --prefix qt@6)"
+          OPENSSL_ROOT="$(brew --prefix openssl@3)"
+          cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DQt6_DIR="$QT_PREFIX/lib/cmake/Qt6" -DOPENSSL_ROOT_DIR="$OPENSSL_ROOT"
+          cmake --build build --parallel
+
+      - name: Verify package
+        shell: bash
+        run: test -x AdaptixClient/build/AdaptixClient
+
+      - name: Package
+        run: |
+          mkdir -p release
+          tar -C AdaptixClient/build -czf "release/AdaptixC2-client-${GITHUB_REF_NAME}-macos.tar.gz" AdaptixClient
+
+      - name: Generate checksum
+        working-directory: release
+        run: sha256sum * > SHA256SUMS
+
+      - name: Upload client
+        uses: actions/upload-artifact@v7
+        with:
+          name: release-macos-client
+          path: release/
+          if-no-files-found: error
+          retention-days: 30
+
+  publish:
+    name: Publish GitHub release
+    needs: [server-linux, linux-client, windows-client, macos-client]
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v7
+        with:
+          fetch-depth: 0
+
+      - name: Download server materials
+        uses: actions/download-artifact@v8
+        with:
+          name: release-server
+          path: release/server
+
+      - name: Download Linux client
+        uses: actions/download-artifact@v8
+        with:
+          name: release-linux-client
+          path: release/linux-client
+
+      - name: Download Windows client
+        uses: actions/download-artifact@v8
+        with:
+          name: release-windows-client
+          path: release/windows-client
+
+      - name: Download macOS client
+        uses: actions/download-artifact@v8
+        with:
+          name: release-macos-client
+          path: release/macos-client
+
+      - name: Consolidate checksums
+        shell: bash
+        run: |
+          set -euo pipefail
+          find release -type f -name SHA256SUMS -delete
+          find release -type f \( -name '*.tar.gz' -o -name '*.zip' -o -name '*.AppImage' -o -name '*.json' \) -print0 | sort -z | xargs -0 sha256sum > release/SHA256SUMS
+
+      - name: Publish release
+        env:
+          GH_TOKEN: ${{ github.token }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          mapfile -d '' -t assets < <(find release -type f \
+            \( -name '*.tar.gz' -o -name '*.zip' -o -name '*.AppImage' -o -name '*.spdx.json' -o -name 'SHA256SUMS' \) -print0)
+          ((${#assets[@]} > 0))
+          gh release create "$GITHUB_REF_NAME" "${assets[@]}" --generate-notes --verify-tag
