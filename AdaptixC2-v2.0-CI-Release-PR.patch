+package profile
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestPatcherAddRemoveAndPrune(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "profile.yaml")
+	data := []byte("Teamserver:\n  interface: 0.0.0.0\n  port: 4321\n  extenders:\n    - \"extenders/existing/config.yaml\"\n  axscripts:\n")
+	if err := os.WriteFile(path, data, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	existingConfig := filepath.Join(dir, "extenders", "existing", "config.yaml")
+	if err := os.MkdirAll(filepath.Dir(existingConfig), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(existingConfig, []byte("name: existing\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	p, err := New(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !p.Has("extenders/existing/config.yaml") {
+		t.Fatal("expected existing extender")
+	}
+	if err := p.Add("extenders/new/config.yaml"); err != nil {
+		t.Fatalf("Add: %v", err)
+	}
+	if err := p.AddTo(ListAxScripts, "axscripts/demo/main.axs"); err != nil {
+		t.Fatalf("AddTo: %v", err)
+	}
+	removed, err := p.PruneMissing(ListExtenders, dir)
+	if err != nil {
+		t.Fatalf("PruneMissing: %v", err)
+	}
+	if len(removed) != 1 || removed[0] != "extenders/new/config.yaml" {
+		t.Fatalf("removed = %v, want newly-added missing extender", removed)
+	}
+	if !p.HasIn(ListAxScripts, "axscripts/demo/main.axs") {
+		t.Fatal("expected axscript entry")
+	}
+}
