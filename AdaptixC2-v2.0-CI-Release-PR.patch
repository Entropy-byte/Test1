+++ b/ci/integration.sh
@@ -0,0 +1,117 @@
+#!/usr/bin/env bash
+set -Eeuo pipefail
+
+usage() {
+  echo "usage: $0 <server-binary> <profile> [host]" >&2
+}
+
+if [[ $# -lt 2 || $# -gt 3 ]]; then
+  usage
+  exit 2
+fi
+
+SERVER_BIN=$1
+PROFILE=$2
+HOST=${3:-127.0.0.1}
+
+command -v openssl >/dev/null || { echo "openssl is required" >&2; exit 1; }
+command -v curl >/dev/null || { echo "curl is required" >&2; exit 1; }
+
+[[ -x "$SERVER_BIN" ]] || { echo "server binary is not executable: $SERVER_BIN" >&2; exit 1; }
+[[ -f "$PROFILE" ]] || { echo "profile not found: $PROFILE" >&2; exit 1; }
+
+port=$(awk '
+  /^  port:/ {gsub(/[^0-9]/, "", $2); print $2; exit}
+' "$PROFILE")
+
+if [[ -z "$port" ]]; then
+  echo "could not determine Teamserver port from $PROFILE" >&2
+  exit 1
+fi
+
+profile_dir=$(cd "$(dirname "$PROFILE")" && pwd)
+server_bin_abs=$(cd "$(dirname "$SERVER_BIN")" && pwd)/$(basename "$SERVER_BIN")
+log_file=$(mktemp)
+pid=""
+cleanup() {
+  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
+    kill "$pid" 2>/dev/null || true
+    for _ in {1..50}; do
+      kill -0 "$pid" 2>/dev/null || break
+      sleep 0.1
+    done
+    kill -9 "$pid" 2>/dev/null || true
+  fi
+  rm -f "$log_file"
+}
+trap cleanup EXIT
+
+(
+  cd "$profile_dir"
+  exec "$server_bin_abs" -profile "$(basename "$PROFILE")"
+) >"$log_file" 2>&1 &
+pid=$!
+
+ready=0
+for _ in {1..120}; do
+  if openssl s_client -connect "$HOST:$port" -servername localhost -tls1_2 </dev/null >/dev/null 2>&1; then
+    ready=1
+    break
+  fi
+  if ! kill -0 "$pid" 2>/dev/null; then
+    echo "server exited before becoming ready" >&2
+    cat "$log_file" >&2
+    exit 1
+  fi
+  sleep 0.25
+done
+
+if [[ "$ready" -ne 1 ]]; then
+  echo "server did not become ready on $HOST:$port" >&2
+  cat "$log_file" >&2
+  exit 1
+fi
+
+echo "[ok] server accepted TLS 1.2"
+
+if openssl s_client -connect "$HOST:$port" -servername localhost -tls1_1 </dev/null >/dev/null 2>&1; then
+  echo "server unexpectedly accepted TLS 1.1" >&2
+  exit 1
+fi
+
+echo "[ok] server rejected TLS 1.1"
+
+http_status=$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
+  --insecure "https://$HOST:$port/")
+case "$http_status" in
+  200|400|401|403|404|405)
+    echo "[ok] HTTPS endpoint responded with HTTP $http_status" ;;
+  *)
+    echo "unexpected HTTPS status: $http_status" >&2
+    cat "$log_file" >&2
+    exit 1 ;;
+esac
+
+for required in adaptixserver profile.yaml 404page.html; do
+  [[ -e "$profile_dir/$required" ]] || { echo "missing runtime file: $required" >&2; exit 1; }
+done
+
+[[ -d "$profile_dir/extenders" ]] || { echo "missing extenders directory" >&2; exit 1; }
+
+shopt -s nullglob
+ext_dirs=("$profile_dir/extenders"/*)
+if [[ ${#ext_dirs[@]} -eq 0 ]]; then
+  echo "no installed extender releases found" >&2
+  exit 1
+fi
+
+for dir in "${ext_dirs[@]}"; do
+  [[ -d "$dir" ]] || continue
+  config_count=$(find "$dir" -maxdepth 1 -type f \( -name 'config.yaml' -o -name 'config.yml' \) | wc -l)
+  so_count=$(find "$dir" -maxdepth 1 -type f -name '*.so' | wc -l)
+  (( config_count >= 1 )) || { echo "extender has no config: $dir" >&2; exit 1; }
+  (( so_count >= 1 )) || { echo "extender has no plugin .so: $dir" >&2; exit 1; }
+done
+
+echo "[ok] runtime layout contains $((${#ext_dirs[@]})) extender release(s)"
+echo "integration: PASS"
-- 
