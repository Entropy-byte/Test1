+package workspace
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestPatcherAddRemoveBlockUse(t *testing.T) {
+	path := filepath.Join(t.TempDir(), GoWorkFileName)
+	contents := "go 1.26.5\n\nuse (\n\t.\n\t./extenders/foo\n)\n"
+	if err := os.WriteFile(path, []byte(contents), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	p, err := New(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !p.Has("./extenders/foo") {
+		t.Fatal("expected existing use entry")
+	}
+	if err := p.Add("./extenders/bar"); err != nil {
+		t.Fatalf("Add: %v", err)
+	}
+	if err := p.Remove("./extenders/foo", false); err != nil {
+		t.Fatalf("Remove: %v", err)
+	}
+	if err := p.Save(); err != nil {
+		t.Fatalf("Save: %v", err)
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := string(data)
+	if p.Has("./extenders/foo") || !p.Has("./extenders/bar") {
+		t.Fatalf("unexpected patcher state")
+	}
+	if want := "./extenders/bar"; !containsLine(got, want) {
+		t.Fatalf("saved go.work missing %q:\n%s", want, got)
+	}
+}
+
+func TestPatcherRejectsUnclosedUseBlock(t *testing.T) {
+	path := filepath.Join(t.TempDir(), GoWorkFileName)
+	if err := os.WriteFile(path, []byte("go 1.26.5\nuse (\n\t.\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	p, err := New(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := p.Add("./extenders/foo"); err == nil {
+		t.Fatal("Add succeeded for unclosed use block")
+	}
+}
+
+func containsLine(s, want string) bool {
+	for _, line := range splitLines(s) {
+		if line == "\t"+want || line == want {
+			return true
+		}
+	}
+	return false
+}
+
+func splitLines(s string) []string {
+	var out []string
+	start := 0
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\n' {
+			out = append(out, s[start:i])
+			start = i + 1
+		}
+	}
+	if start < len(s) {
+		out = append(out, s[start:])
+	}
+	return out
+}
