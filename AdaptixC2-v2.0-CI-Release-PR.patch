+func TestSaveLoadSortsAndPreservesEntries(t *testing.T) {
+	dir := t.TempDir()
+	f := File{Plugins: []Entry{
+		{Name: "zeta", Version: "1.0.0", Type: "listener", SourcePath: "extenders/zeta"},
+		{Name: "alpha", Version: "1.0.0", Type: "agent", SourcePath: "extenders/alpha"},
+	}}
+	if err := Save(dir, f); err != nil {
+		t.Fatalf("Save: %v", err)
+	}
+
+	path := filepath.Join(dir, FileName)
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("ReadFile: %v", err)
+	}
+	if len(data) == 0 || data[0] != '#' {
+		t.Fatalf("state file is missing managed header: %q", string(data))
+	}
+
+	got, err := Load(dir)
+	if err != nil {
+		t.Fatalf("Load: %v", err)
+	}
+	if got.Names()[0] != "alpha" || got.Names()[1] != "zeta" {
+		t.Fatalf("Names() = %v, want [alpha zeta]", got.Names())
+	}
+	if got.Find("alpha") == nil {
+		t.Fatal("Find(alpha) returned nil")
+	}
+	if !got.Remove("alpha") || got.Find("alpha") != nil {
+		t.Fatal("Remove(alpha) failed")
