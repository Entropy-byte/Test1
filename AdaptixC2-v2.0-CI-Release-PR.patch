@@ -0,0 +1,33 @@
+package fsutil
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestCopyTreeSkipsGitAndRejectsTraversalTarget(t *testing.T) {
+	src := t.TempDir()
+	dst := filepath.Join(t.TempDir(), "copy")
+	if err := os.MkdirAll(filepath.Join(src, ".git"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(src, "file.txt"), []byte("ok"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(src, ".git", "ignored"), []byte("no"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := CopyTree(src, dst); err != nil {
+		t.Fatalf("CopyTree: %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(dst, "file.txt")); err != nil {
+		t.Fatalf("copied file missing: %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(dst, ".git")); !os.IsNotExist(err) {
+		t.Fatalf(".git should be skipped, stat error = %v", err)
+	}
+	if IsSubPath(dst, filepath.Join(dst, "..", "outside")) {
+		t.Fatal("IsSubPath incorrectly accepted escaped target")
+	}
+}
diff --git a/AdaptixTools/internal/install/rollback_test.go b/AdaptixTools/internal/install/rollback_test.go
new file mode 100644
index 0000000..c3cf25d
--- /dev/null
+++ b/AdaptixTools/internal/install/rollback_test.go
@@ -0,0 +1,40 @@
+package install
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestRollbackRestoresSnapshotAndRemovesNewFile(t *testing.T) {
+	dir := t.TempDir()
+	original := filepath.Join(dir, "original.txt")
+	missing := filepath.Join(dir, "missing.txt")
+	if err := os.WriteFile(original, []byte("before"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	rb := newRollback()
+	rb.snapshotFile(original)
+	rb.snapshotFile(missing)
+	if err := os.WriteFile(original, []byte("after"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(missing, []byte("new"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := rb.apply(os.Stdout); err != nil {
+		t.Fatalf("apply: %v", err)
+	}
+
+	data, err := os.ReadFile(original)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(data) != "before" {
+		t.Fatalf("original = %q, want before", data)
+	}
+	if _, err := os.Stat(missing); !os.IsNotExist(err) {
+		t.Fatalf("missing file was not removed: %v", err)
+	}
+}
