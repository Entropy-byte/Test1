--- /dev/null
+++ b/ci/verify-workflows.py
@@ -0,0 +1,31 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+
+import pathlib
+import sys
+
+try:
+    import yaml
+except ImportError:
+    print("PyYAML is required to validate workflow YAML", file=sys.stderr)
+    raise SystemExit(1)
+
+root = pathlib.Path(__file__).resolve().parents[1]
+files = sorted((root / ".github" / "workflows").glob("*.yml"))
+if not files:
+    print("no workflows found", file=sys.stderr)
+    raise SystemExit(1)
+
+for path in files:
+    with path.open("r", encoding="utf-8") as fh:
+        data = yaml.safe_load(fh)
+    if not isinstance(data, dict):
+        raise SystemExit(f"{path}: top-level YAML document must be a mapping")
+    # PyYAML 1.1 parses the key `on` as boolean; check both forms.
+    trigger = data.get("on", data.get(True))
+    if trigger is None:
+        raise SystemExit(f"{path}: missing workflow trigger")
+    jobs = data.get("jobs")
+    if not isinstance(jobs, dict) or not jobs:
+        raise SystemExit(f"{path}: missing jobs")
+    print(f"valid: {path.relative_to(root)}")
