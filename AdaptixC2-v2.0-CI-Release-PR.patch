+package spec
+
+import "testing"
+
+func TestIsSafeName(t *testing.T) {
+	valid := []string{"beacon_agent", "listener-http", "a", "a1", "x_y-z"}
+	for _, name := range valid {
+		if !IsSafeName(name) {
+			t.Fatalf("IsSafeName(%q) = false, want true", name)
+		}
+	}
+
+	invalid := []string{"", "-bad", "_bad", "Bad", "a.b", "a/b", "a b"}
+	for _, name := range invalid {
+		if IsSafeName(name) {
+			t.Fatalf("IsSafeName(%q) = true, want false", name)
+		}
+	}
+}
+
+func TestServerSpecRejectsUnsafePaths(t *testing.T) {
+	s := ServerSpec{
+		ServerVersion: "v2.0",
+		ServerDir:     "AdaptixServer",
+		PluginDir:     "../outside",
+		ExtDir:        "dist/extenders",
+		DistDir:       "dist",
+		Profile:       "dist/profile.yaml",
+	}
+	if err := s.Validate(); err == nil {
+		t.Fatal("Validate() succeeded for unsafe plugin_dir")
+	}
