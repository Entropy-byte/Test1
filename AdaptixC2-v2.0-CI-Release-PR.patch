+++ b/AdaptixTools/cmd/root_test.go
@@ -0,0 +1,46 @@
+package cmd
+
+import "testing"
+
+func TestPreprocessArgsStandaloneCommands(t *testing.T) {
+	standalone := [][]string{
+		{"axtool", "build", "./plugin"},
+		{"axtool", "init", "listener", "demo"},
+		{"axtool", "template", "listener", "demo"},
+		{"axtool", "validate", "./plugin"},
+	}
+
+	for _, args := range standalone {
+		projectSpecPath = ""
+		got := preprocessArgs(args)
+		if projectSpecPath != "" {
+			t.Fatalf("preprocessArgs(%v) unexpectedly set projectSpecPath to %q", args, projectSpecPath)
+		}
+		if len(got) != len(args) {
+			t.Fatalf("preprocessArgs(%v) changed argument count: got %v", args, got)
+		}
+		for i := range args {
+			if got[i] != args[i] {
+				t.Fatalf("preprocessArgs(%v) changed args to %v", args, got)
+			}
+		}
+	}
+}
+
+func TestPreprocessArgsProjectCommand(t *testing.T) {
+	projectSpecPath = ""
+	got := preprocessArgs([]string{"axtool", "adaptix.spec", "server", "build"})
+
+	if projectSpecPath != "adaptix.spec" {
+		t.Fatalf("projectSpecPath = %q, want %q", projectSpecPath, "adaptix.spec")
+	}
+	want := []string{"axtool", "server", "build"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v, want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v, want %v", got, want)
+		}
+	}
+}
diff --git a/AdaptixTools/internal/build/release_test.go b/AdaptixTools/internal/build/release_test.go
new file mode 100644
index 0000000..b074c45
--- /dev/null
+++ b/AdaptixTools/internal/build/release_test.go
@@ -0,0 +1,66 @@
+package build
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"axtool/internal/spec"
+)
+
+func TestVerifyReleaseFindsConfigAndPlugin(t *testing.T) {
+	dir := t.TempDir()
+	release := filepath.Join(dir, "dist")
+	if err := os.MkdirAll(release, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	so := filepath.Join(release, "plugin.so")
+	cfg := filepath.Join(release, "config.yaml")
+	for _, path := range []string{so, cfg} {
+		if err := os.WriteFile(path, []byte("test"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	files, err := CollectRelease(dir, spec.Release{Dir: "dist"})
+	if err != nil {
+		t.Fatalf("CollectRelease: %v", err)
+	}
+	got, err := VerifyRelease(files, release, "")
+	if err != nil {
+		t.Fatalf("VerifyRelease: %v", err)
+	}
+	if got != "config.yaml" {
+		t.Fatalf("config = %q, want config.yaml", got)
+	}
+}
+
+func TestVerifyReleaseRejectsMissingConfigAndPlugin(t *testing.T) {
+	dir := t.TempDir()
+	release := filepath.Join(dir, "dist")
+	if err := os.MkdirAll(release, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	so := filepath.Join(release, "plugin.so")
+	if err := os.WriteFile(so, []byte("test"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	files, err := CollectRelease(dir, spec.Release{Dir: "dist"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := VerifyRelease(files, release, ""); err == nil {
+		t.Fatal("VerifyRelease succeeded without config")
+	}
+
+	os.Remove(so)
+	if err := os.WriteFile(filepath.Join(release, "config.yaml"), []byte("test"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	files, err = CollectRelease(dir, spec.Release{Dir: "dist"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := VerifyRelease(files, release, ""); err == nil {
+		t.Fatal("VerifyRelease succeeded without plugin .so")
+	}
+}
